diff --git a/lib/animation/continuousPackedReader.py b/lib/animation/continuousPackedReader.py
index dbc7f68..4279769 100644
--- a/lib/animation/continuousPackedReader.py
+++ b/lib/animation/continuousPackedReader.py
@@ -8,3 +8,11 @@ class OdinContinuousPackedReader(OdinPackedReader):
 class OdinContinuousPackedReader(OdinPackedReader):
+    @staticmethod
+    def decode_base_rotation_component(raw_value: int) -> float:
+        """Decode packed uint16 quaternion bits as signed int16 / 32767."""
+        signed_value = int(raw_value.item() if hasattr(raw_value, "item") else raw_value)
+        if signed_value >= 0x8000:
+            signed_value -= 0x10000
+        return max(-1.0, signed_value / 32767.0)
+
     def __init__(self, gltf, animation):
         super().__init__(gltf, animation)
@@ -116,3 +116,3 @@ class OdinContinuousPackedReader(OdinPackedReader):
         result = [
-            self.rotation_data[self.rotation_counter + i]
+            self.decode_base_rotation_component(self.rotation_data[self.rotation_counter + i])
             for i in range(RotationChannels)
         ]
         self.rotation_counter += RotationChannels
