{
  "name": "statsconnect-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "estimate:crawler-cost": "node scripts/estimate-crawler-cost.mjs",
    "dev": "pnpm --parallel --filter @statsconnect/backend --filter statsconnect dev",
    "dev:mobile": "node scripts/mobile-dev.ts",
    "dev:hub": "pnpm --filter statsconnect dev",
    "dev:brawlstats": "pnpm --filter brawlstats.io dev",
    "dev:clashcrown": "pnpm --filter clash-crown dev",
    "preview:phone": "node scripts/phone-preview.ts",
    "materialize:brawl-assets": "node scripts/materialize-brawl-assets.mjs",
    "build": "node scripts/production-delivery.ts build",
    "build:unified": "node scripts/production-delivery.ts build",
    "build:vercel": "node scripts/production-delivery.ts vercel",
    "deploy:backend": "pnpm --filter @statsconnect/backend deploy",
    "deploy:unified": "node scripts/production-delivery.ts deploy",
    "test": "node --test scripts/*.test.ts server/*.test.ts && pnpm -r --if-present test",
    "verify": "node scripts/release-gate.ts",
    "test:delivery": "node --test scripts/production-delivery.test.ts",
    "typecheck": "pnpm typecheck:delivery && pnpm typecheck:profile-previews && pnpm -r --if-present typecheck",
    "typecheck:delivery": "tsc --noEmit -p scripts/tsconfig.json",
    "test:profile-previews": "node --test server/profile-preview.test.ts",
    "typecheck:profile-previews": "tsc --noEmit -p server/tsconfig.json"
  },
  "devDependencies": {
    "@clerk/backend": "^3.22.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2",
    "vite": "catalog:"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "convex": "^1.43.0"
  }
}
