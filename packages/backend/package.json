{
  "name": "@statsconnect/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "exports": {
    "./data-model": "./data-model.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "deploy:with-frontend": "convex deploy --cmd-url-env-var-name VITE_CONVEX_URL --cmd 'pnpm --dir ../.. build:unified'",
    "test": "node --test test/*.test.ts tests/*.test.mjs convex/*.test.ts convex/brawl/*.test.ts convex/clash/*.test.ts && vitest run",
    "typecheck": "tsc --noEmit -p convex/tsconfig.json"
  },
  "dependencies": {
    "@convex-dev/better-auth": "^0.12.5",
    "better-auth": "~1.6.29",
    "convex": "^1.43.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex-test": "^0.0.62",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
