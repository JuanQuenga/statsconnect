# Copy these public URLs from packages/backend/.env.local.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_STATSCONNECT_ORIGIN=https://statsconnect.app
# VITE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
# VITE_ADSENSE_CLASH_HOME_SLOT=1234567890
# VITE_SUPERCELL_CREATOR_CODE=YOUR_APPROVED_CODE
# Local UI review only; use "demo" without a Convex URL, or leave as "live".
VITE_CLASHCROWN_DATA_MODE=live

# Browser analytics and error monitoring. Public ingestion keys only.
# Set these for all three apps, or in the unified build environment.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
# Optional release identifier, ideally the deployed commit SHA.
VITE_SENTRY_RELEASE=
# Optional: distinguish production from preview events.
# VITE_MONITORING_ENVIRONMENT=production
# Opt in during local verification only; production enables monitoring by default.
# VITE_MONITORING_ENABLED=1

# Optional verified live hosted checkout URL. No API key or recurring payments.
# Leave blank until account verification and the public checkout are ready.
VITE_STATSCONNECT_SUPPORT_URL=
