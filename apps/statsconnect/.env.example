# The Platform Backend writes its selector to packages/backend/.env.local.
# Copy its client URL here. Do not create an app-local Convex deployment.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Clerk publishable key (pk_live_... in production). Sign-in is unavailable
# without it; the app falls back to guest-only profiles.
VITE_CLERK_PUBLISHABLE_KEY=

# The unified production build uses the Hub HTML for all three sites. Add the
# same AdSense client ID here and to both game app environments for standalone
# builds. The unified production build already includes the assigned ID.
# VITE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456

# Browser analytics and error monitoring. Public ingestion keys only.
# Set these for all three apps, or in the unified build environment.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
# Optional release identifier, ideally the deployed commit SHA.
VITE_SENTRY_RELEASE=
# Optional: distinguish production from preview events.
# VITE_MONITORING_ENVIRONMENT=production
# Opt in during local verification only; production enables monitoring by default.
# VITE_MONITORING_ENABLED=1

# Verified public hosted support URLs. No API keys.
# The verified one-time support link. Leave blank to hide support links.
VITE_STATSCONNECT_SUPPORT_URL=https://buy.stripe.com/bJedRaffk3lr7igdOG4AU00
# Monthly support is $5 USD/month until canceled; requires the portal URL.
VITE_STATSCONNECT_MONTHLY_SUPPORT_URL=https://buy.stripe.com/28E28s8QW6xD9qobGy4AU01
# Keep the management link available even if monthly signups are disabled.
VITE_STATSCONNECT_SUPPORT_PORTAL_URL=https://billing.stripe.com/p/login/bJedRaffk3lr7igdOG4AU00
