# The Platform Backend writes its selector to packages/backend/.env.local.
# Copy its client URL here. Do not create an app-local Convex deployment.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public destination origins used by /launch/:game.
VITE_BRAWLSTATS_ORIGIN=https://stats.juanquenga.com/bs
VITE_CLASHCROWN_ORIGIN=https://stats.juanquenga.com/cr
