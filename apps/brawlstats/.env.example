# Copy VITE_CONVEX_URL from packages/backend/.env.local. The frontend converts
# its .convex.cloud URL to the matching .convex.site URL.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Or set the HTTP Actions URL explicitly:
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public StatsConnect hub origin used by the cross-game switcher.
VITE_STATSCONNECT_ORIGIN=https://stats.juanquenga.com

# Optional local-only directory produced by the asset conversion pipeline.
# If omitted, dev uses the ignored repository fallback .generated/brawl-3d.
# Requests remain same-origin at /assets/brawlers/3d/*; the Vite dev server
# serves files from this directory without copying them into the repository.
BRAWL_3D_ASSET_DIR=/absolute/path/to/converted-brawl-3d

# Production-only project-controlled storage origin used by the Vercel proxy.
# Keep this out of VITE_* variables and configure it in Vercel's environment
# settings. The browser and generated manifests never receive this origin.
BRAWL_3D_ASSET_STORAGE_ORIGIN=https://your-project-owned-asset-storage.example
VITE_BRAWLSTATS_ORIGIN=https://stats.juanquenga.com/bs
VITE_CLASHCROWN_ORIGIN=https://stats.juanquenga.com/cr
