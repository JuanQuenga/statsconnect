# `convex dev` normally writes VITE_CONVEX_URL. The frontend converts the
# .convex.cloud URL to the matching .convex.site HTTP Actions URL.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Or set the HTTP Actions URL explicitly:
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public StatsConnect hub origin used by the cross-game switcher.
VITE_STATSCONNECT_ORIGIN=https://statsconnect.com

# Set these in Convex, not in the frontend environment.
# pnpm convex env set BRAWL_STARS_API_TOKEN your-token
BRAWL_STARS_API_TOKEN=
BRAWL_STARS_API_BASE_URL=https://api.brawlstars.com/v1
# Optional crawler tuning (set in Convex).
BRAWL_CRAWLER_ENABLED=true
BRAWL_PUBLIC_API_ENABLED=true
BRAWL_CRAWL_MAX_CALLS_PER_HOUR=500
BRAWL_PUBLIC_MAX_CALLS_PER_HOUR=1000
BRAWL_DISCOVER_LIMIT=200
BRAWL_CLUB_SEED=10
BRAWL_CRAWL_BATCH=8
BRAWL_CRAWL_REVISIT_MINUTES=30
BRAWL_PROFILE_REVISIT_HOURS=12
BRAWL_PLAYER_PROFILE_CACHE_SECONDS=900
BRAWL_PLAYER_BATTLE_CACHE_SECONDS=120
