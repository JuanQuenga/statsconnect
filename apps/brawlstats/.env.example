# Copy VITE_CONVEX_URL from packages/backend/.env.local. The frontend converts
# its .convex.cloud URL to the matching .convex.site URL.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Or set the HTTP Actions URL explicitly:
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Clerk publishable key (pk_live_... in production). Sign-in is unavailable
# without it; the app falls back to guest-only profiles.
VITE_CLERK_PUBLISHABLE_KEY=

# Public StatsConnect hub origin used by the cross-game switcher.
VITE_STATSCONNECT_ORIGIN=https://statsconnect.app

# Set the client ID during AdSense site review for ownership verification.
# Without both the client and slot IDs, the home-page placement is absent.
# VITE_ADSENSE_CLIENT_ID=ca-pub-1234567890123456
# VITE_ADSENSE_BRAWL_HOME_SLOT=1234567890
# Set only after Supercell assigns a creator code to you.
# VITE_SUPERCELL_CREATOR_CODE=YOUR_CODE

# Optional local-only directory produced by the asset conversion pipeline.
# If omitted, dev uses the ignored repository fallback .generated/brawl-3d.
# Requests remain same-origin at /assets/brawlers/3d/*; the Vite dev server
# serves files from this directory without copying them into the repository.
BRAWL_3D_ASSET_DIR=/absolute/path/to/converted-brawl-3d

# Production-only project-controlled storage origin used by the Vercel proxy.
# This is required for the generated catalog; if it is absent, production
# fails closed and the viewer uses tracked legacy GLBs or official PNG art.
# Keep this out of VITE_* variables and configure it in Vercel's environment
# settings. The browser and generated manifests never receive this origin.
BRAWL_3D_ASSET_STORAGE_ORIGIN=https://your-project-owned-asset-storage.example

# Browser analytics and error monitoring. Public ingestion keys only.
# Set these for all three apps, or in the unified build environment.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
# Optional release identifier, ideally the deployed commit SHA.
VITE_SENTRY_RELEASE=
# Optional: distinguish production from preview events.
# VITE_MONITORING_ENVIRONMENT=production
# Opt in during local verification only; production enables monitoring by default.
# VITE_MONITORING_ENABLED=1

# Verified public hosted support URLs. No API keys.
# The verified one-time support link. Leave blank to hide support links.
VITE_STATSCONNECT_SUPPORT_URL=https://buy.stripe.com/bJedRaffk3lr7igdOG4AU00
# Monthly support is $5 USD/month until canceled; requires the portal URL.
VITE_STATSCONNECT_MONTHLY_SUPPORT_URL=https://buy.stripe.com/28E28s8QW6xD9qobGy4AU01
# Keep the management link available even if monthly signups are disabled.
VITE_STATSCONNECT_SUPPORT_PORTAL_URL=https://billing.stripe.com/p/login/bJedRaffk3lr7igdOG4AU00
