# Copy VITE_CONVEX_URL from packages/backend/.env.local. The frontend converts
# its .convex.cloud URL to the matching .convex.site URL.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Or set the HTTP Actions URL explicitly:
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Public StatsConnect hub origin used by the cross-game switcher.
VITE_STATSCONNECT_ORIGIN=https://statsconnect.com
VITE_BRAWLSTATS_ORIGIN=https://brawlstats.juanquenga.com
VITE_CLASHCROWN_ORIGIN=https://clashcrown.juanquenga.com
