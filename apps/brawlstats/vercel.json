{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff HEAD^ HEAD --quiet -- . ../../packages/site-nav ../../packages/site-errors ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml",
  "headers": [
    {
      "source": "/beta",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/assistant", "destination": "/index.html" },
    { "source": "/bands", "destination": "/index.html" },
    { "source": "/beta", "destination": "/index.html" },
    { "source": "/brawlers", "destination": "/index.html" },
    { "source": "/brawlers/:brawlerId", "destination": "/index.html" },
    { "source": "/clubs", "destination": "/index.html" },
    { "source": "/gamemodes/:modeId", "destination": "/index.html" },
    { "source": "/leaderboards", "destination": "/index.html" },
    { "source": "/maps", "destination": "/index.html" },
    { "source": "/maps/:mapId", "destination": "/index.html" },
    { "source": "/meta", "destination": "/index.html" },
    { "source": "/players", "destination": "/index.html" },
    { "source": "/progression", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ]
}
