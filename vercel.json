{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build:vercel",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/brawlstars/beta",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/clashroyale/beta",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/brawlstars", "destination": "/brawlstars/index.html" },
    { "source": "/brawlstars/:path*", "destination": "/brawlstars/index.html" },
    { "source": "/clashroyale", "destination": "/clashroyale/index.html" },
    { "source": "/clashroyale/:path*", "destination": "/clashroyale/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
