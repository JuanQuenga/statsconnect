{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["../apps/clashcrown/src/*"] }
  },
  "include": ["*.ts", "../api/profile-*.ts", "../api/site-shell.ts", "../shared/profile-image-runtime.ts"]
}
